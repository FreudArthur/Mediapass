{
  "version": "0.2.0",
  "configurations": [
    {
       "name": "Déboguer C++ avec MinGW",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/Mediapass/main.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/Mediapass",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Activer l'impression automatique",
          "text": "-enable-pretty-print",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build"
    }
  ]
}